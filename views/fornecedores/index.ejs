<%- include("../partials/header") %>
<%- include("../partials/nav") %>

<div class="page-shell">
  <div class="page-header">
    <div>
      <span class="eyebrow">Gestão</span>
      <h1 class="page-title">Fornecedores</h1>
      <p class="page-subtitle">Lista de fornecedores cadastrados no sistema.</p>
    </div>

    <div class="page-actions">
      <a href="/fornecedores/cadastrar" class="btn btn-primary">
        <i class="bi bi-building-add me-2"></i>Novo Fornecedor
      </a>
    </div>
  </div>

  <div class="card-modern table-card">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-modern align-middle">
          <thead>
            <tr>
              <th>ID</th>
              <th>Razão Social</th>
              <th>CNPJ</th>
              <th>Email</th>
              <th>Telefone</th>
              <th>Cidade</th>
              <th>Opções</th>
            </tr>
          </thead>
          <tbody>
            <% fornecedores.forEach(fornecedor => { %>
              <tr>
                <td>#<%= fornecedor.id %></td>
                <td><strong><%= fornecedor.razaoSocial %></strong></td>
                <td><%= fornecedor.cnpj %></td>
                <td><%= fornecedor.email %></td>
                <td><%= fornecedor.telefone %></td>
                <td><%= fornecedor.cidade %></td>
                <td>
                  <div class="table-actions">
                    <a class="btn btn-success btn-sm" href="/fornecedores/editar/<%= fornecedor.id %>">
                      <i class="bi bi-pencil-square me-1"></i>Editar
                    </a>
                    <a class="btn btn-warning btn-sm" href="/fornecedores/excluir/<%= fornecedor.id %>"
                      onclick="return confirm('Deseja excluir este fornecedor?')">
                      <i class="bi bi-trash3 me-1"></i>Excluir
                    </a>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include("../partials/footer") %>