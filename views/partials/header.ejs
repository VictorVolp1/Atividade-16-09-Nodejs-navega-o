<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sistema de Gestão</title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
      rel="stylesheet"
    />

    <style>
      :root {
        --green-950: #0d3c34;
        --green-900: #124f45;
        --green-800: #1d6b59;
        --green-700: #2a866b;
        --green-600: #38a67d;
        --green-500: #4bc591;
        --green-100: #eafaf3;
        --green-50: #f4fbf8;
        --slate-900: #1d2a2a;
        --slate-700: #415452;
        --slate-500: #6b7b77;
        --slate-300: #dfeae7;
        --bg: #edf5f2;
        --card: #ffffff;
        --shadow: 0 20px 45px rgba(12, 61, 52, 0.12);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        background:
          radial-gradient(circle at top, rgba(76, 197, 145, 0.16), transparent 30%),
          linear-gradient(180deg, #f6faf8 0%, var(--bg) 100%);
        color: var(--slate-900);
      }

      a {
        text-decoration: none;
      }

      .navbar-modern {
        background: rgba(10, 41, 34, 0.95);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 12px 30px rgba(10, 41, 34, 0.18);
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.7rem;
        color: #fff;
        font-size: 1.2rem;
        font-weight: 700;
        letter-spacing: 0.02em;
      }

      .brand i {
        color: var(--green-500);
        font-size: 1.4rem;
      }

      .navbar-modern .nav-link {
        color: rgba(255, 255, 255, 0.82);
        font-weight: 600;
        border-radius: 10px;
        padding: 0.65rem 0.9rem;
        transition: all 0.2s ease;
      }

      .navbar-modern .nav-link:hover,
      .navbar-modern .nav-link.active {
        color: #fff;
        background: rgba(76, 197, 145, 0.18);
      }

      .page-shell {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem 1rem 4rem;
      }

      .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
        padding-top: 0.5rem;
      }

      .eyebrow {
        display: inline-block;
        margin-bottom: 0.5rem;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        color: var(--green-700);
        text-transform: uppercase;
      }

      .page-title {
        margin: 0;
        font-size: clamp(2rem, 4vw, 3rem);
        line-height: 1.1;
        font-weight: 800;
        color: var(--slate-900);
      }

      .page-subtitle {
        margin: 0.5rem 0 0;
        color: var(--slate-500);
        font-size: 1.02rem;
      }

      .page-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 0.75rem;
      }

      .btn {
        border-radius: 12px;
        font-weight: 700;
        padding: 0.75rem 1.25rem;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .btn:hover {
        transform: translateY(-1px);
      }

      .btn-primary {
        background: linear-gradient(135deg, var(--green-700), var(--green-600));
        border: none;
        box-shadow: 0 12px 24px rgba(42, 134, 107, 0.22);
      }

      .btn-primary:hover,
      .btn-primary:focus {
        background: linear-gradient(135deg, var(--green-800), var(--green-700));
      }

      .btn-success {
        background: linear-gradient(135deg, var(--green-700), var(--green-600));
        border: none;
      }

      .btn-warning {
        background: linear-gradient(135deg, #ffb86c, #f39a3d);
        border: none;
        color: #fff;
      }

      .btn-outline-secondary {
        border-color: var(--slate-300);
        color: var(--slate-700);
      }

      .btn-outline-secondary:hover {
        background: #f1f4f3;
        color: var(--slate-900);
      }

      .hero-card,
      .card-modern,
      .form-card {
        background: var(--card);
        border: 1px solid rgba(197, 217, 209, 0.8);
        border-radius: 22px;
        box-shadow: var(--shadow);
      }

      .hero-card {
        padding: 2.5rem;
        margin-top: 1rem;
      }

      .hero-card h1 {
        font-size: clamp(2.2rem, 5vw, 4rem);
        font-weight: 800;
        margin-bottom: 1rem;
      }

      .hero-card p {
        color: var(--slate-700);
        font-size: 1.08rem;
        line-height: 1.7;
      }

      .stat-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;
        margin-top: 2rem;
      }

      .stat-card {
        background: linear-gradient(180deg, #ffffff 0%, #f3fbf8 100%);
        border: 1px solid rgba(197, 217, 209, 0.8);
        border-radius: 18px;
        padding: 1.2rem 1rem;
        box-shadow: 0 12px 28px rgba(15, 61, 52, 0.06);
      }

      .stat-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        margin-bottom: 0.75rem;
        border-radius: 12px;
        background: rgba(76, 197, 145, 0.13);
        color: var(--green-800);
        font-size: 1.3rem;
      }

      .stat-card h3 {
        margin: 0;
        font-size: 1.9rem;
        font-weight: 800;
        color: var(--slate-900);
      }

      .stat-card span {
        color: var(--slate-500);
        font-size: 0.94rem;
        font-weight: 600;
      }

      .table-card {
        overflow: hidden;
      }

      .table-modern {
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
      }

      .table-modern thead th {
        background: linear-gradient(135deg, var(--green-900), var(--green-800));
        color: #fff;
        border: none;
        font-size: 0.78rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        padding: 0.95rem 1rem;
      }

      .table-modern tbody td {
        padding: 1rem;
        border-bottom: 1px solid var(--slate-300);
        vertical-align: middle;
        color: var(--slate-700);
        background: rgba(255, 255, 255, 0.6);
      }

      .table-modern tbody tr:hover td {
        background: rgba(76, 197, 145, 0.05);
      }

      .table-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      .table-actions .btn {
        padding: 0.55rem 0.9rem;
        font-size: 0.8rem;
      }

      .form-card {
        overflow: hidden;
      }

      .form-header {
        background: linear-gradient(135deg, var(--green-900), var(--green-700));
        color: #fff;
        padding: 1.2rem 1.5rem;
      }

      .form-header h4 {
        margin: 0;
        font-size: 1.4rem;
        font-weight: 700;
      }

      .form-body {
        padding: 1.5rem;
      }

      .form-group {
        margin-bottom: 1.1rem;
      }

      .form-label {
        display: block;
        margin-bottom: 0.55rem;
        color: var(--slate-700);
        font-weight: 700;
      }

      .form-control,
      .form-select {
        width: 100%;
        border: 1px solid var(--slate-300);
        border-radius: 14px;
        background: #f9fbfa;
        padding: 0.8rem 1rem;
        color: var(--slate-900);
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
      }

      .form-control:focus,
      .form-select:focus {
        border-color: var(--green-600);
        box-shadow: 0 0 0 0.2rem rgba(56, 166, 125, 0.18);
        outline: none;
        background: #fff;
      }

      .form-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 1.5rem;
      }

      .actions-inline {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      .muted {
        color: var(--slate-500);
      }

      @media (max-width: 992px) {
        .page-header {
          flex-direction: column;
          align-items: flex-start;
        }

        .page-actions {
          justify-content: flex-start;
        }

        .stat-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 576px) {
        .page-shell {
          padding-left: 0.75rem;
          padding-right: 0.75rem;
        }

        .hero-card,
        .form-body {
          padding: 1.1rem;
        }

        .stat-grid {
          grid-template-columns: 1fr;
        }

        .table-actions {
          flex-direction: column;
          align-items: stretch;
        }
      }
    </style>
  </head>

  <body>
